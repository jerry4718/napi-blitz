{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021"],
    "strict": true,
    "moduleResolution": "node",
    "module": "ESNext",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "declaration": true,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["native/**/*.ts", "src-js/**/*.ts"],
  "exclude": ["node_modules", "benchmark", "__test__", "external", "examples", "dist"]
}
