{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "moduleResolution": "node",
    "module": "ES2022",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "declaration": true,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["native/**/*", "src-js/**/*"],
  "exclude": ["node_modules", "benchmark", "__test__", "external", "examples", "dist"]
}
