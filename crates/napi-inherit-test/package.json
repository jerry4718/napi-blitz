{
  "name": "napi-inherit-test",
  "version": "0.2.219",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "napi build --platform --output-dir lib --dts index.d.ts --js index.cjs",
    "test": "ava"
  },
  "dependencies": {
    "@napi-rs/cli": "catalog:",
    "@oxc-node/core": "catalog:",
    "@types/node": "catalog:",
    "ava": "catalog:",
    "cross-env": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "napi": {
    "binaryName": "napi-inherit-test",
    "dtsHeaderFile": "header.d.ts",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-freebsd",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-pc-windows-msvc",
      "x86_64-pc-windows-msvc"
    ]
  },
  "ava": {
    "extensions": ["ts"],
    "files": ["test/**/*.spec.ts"],
    "timeout": "2m",
    "workerThreads": false,
    "environmentVariables": {
      "TS_NODE_PROJECT": "./tsconfig.json",
      "RUST_BACKTRACE": "full"
    },
    "nodeArguments": ["--import", "@oxc-node/core/register"]
  }
}
